#-----------------------------------------------------------------------------
# PRODUCTION KOBWEB DOCKER BUILD
# Optimized for: Speed, Size, Reliability, Proper Export
# Features: Line ending fixes, efficient export, minimal runtime
#-----------------------------------------------------------------------------

ARG KOBWEB_APP_ROOT="site"

#-----------------------------------------------------------------------------
# Stage 1: Dependency Cache Layer
#-----------------------------------------------------------------------------
FROM eclipse-temurin:21-jdk AS deps

ENV KOBWEB_CLI_VERSION=0.9.15
ARG KOBWEB_APP_ROOT

# Copy only build files needed for dependency resolution
COPY gradle/ /project/gradle/
COPY *.gradle.kts /project/
COPY *.properties /project/
COPY gradlew* /project/

WORKDIR /project

# Configure minimal Gradle settings for dependency download
RUN mkdir -p ~/.gradle && echo "\
org.gradle.jvmargs=-Xmx800m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError\n\
org.gradle.daemon=false\n\
org.gradle.parallel=false\n\
org.gradle.console=plain" > ~/.gradle/gradle.properties

# Fix line endings and download dependencies
RUN sed -i 's/\r$//' gradlew && \
    chmod +x gradlew && \
    ./gradlew dependencies --no-daemon --console=plain || true

#-----------------------------------------------------------------------------
# Stage 2: Build and Export
#-----------------------------------------------------------------------------
FROM eclipse-temurin:21-jdk AS export

ENV KOBWEB_CLI_VERSION=0.9.15
ARG KOBWEB_APP_ROOT

# Copy cached Gradle dependencies from deps stage
COPY --from=deps /root/.gradle /root/.gradle

# Copy all project files
COPY gradle/ /project/gradle/
COPY site/ /project/site/
COPY *.gradle.kts /project/
COPY *.properties /project/
COPY gradlew* /project/
# Note: local.properties is excluded by .dockerignore for security

# Install build dependencies including browser for Kobweb export
# CRITICAL: Kobweb export requires a browser for static site generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    sed \
    wget \
    ca-certificates \
    gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g npm@10.8.2 \
    && npx playwright@1.46.1 install --with-deps chromium \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Download Kobweb CLI with retry mechanism
RUN set -e && \
    KOBWEB_URL="https://github.com/varabyte/kobweb-cli/releases/download/v${KOBWEB_CLI_VERSION}/kobweb-${KOBWEB_CLI_VERSION}.zip" && \
    echo "Downloading Kobweb CLI..." && \
    for i in {1..3}; do \
        if curl -L --connect-timeout 30 --max-time 120 --retry 2 --retry-delay 3 --fail "$KOBWEB_URL" -o "kobweb-${KOBWEB_CLI_VERSION}.zip"; then \
            break; \
        fi; \
        if [ $i -eq 3 ]; then \
            echo "Download failed" && exit 1; \
        fi; \
        sleep 5; \
    done && \
    unzip "kobweb-${KOBWEB_CLI_VERSION}.zip" && \
    rm "kobweb-${KOBWEB_CLI_VERSION}.zip"

ENV PATH="/kobweb-${KOBWEB_CLI_VERSION}/bin:${PATH}"
WORKDIR /project/${KOBWEB_APP_ROOT}

# Configure Gradle for container builds - Conservative settings for Docker stability
RUN mkdir -p ~/.gradle && echo "\
org.gradle.jvmargs=-Xmx800m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError\n\
org.gradle.daemon=false\n\
org.gradle.parallel=false\n\
org.gradle.configureondemand=false\n\
org.gradle.console=plain\n\
org.gradle.logging.level=lifecycle\n\
org.gradle.workers.max=2" > ~/.gradle/gradle.properties

# Create minimal local.properties for Docker builds
RUN echo "# Docker build - minimal properties" > ../local.properties && \
    echo "type=service_account" >> ../local.properties && \
    echo "project_id=docker-build" >> ../local.properties && \
    echo "private_key_id=docker" >> ../local.properties && \
    echo "private_key=docker" >> ../local.properties && \
    echo "client_email=docker@build.com" >> ../local.properties && \
    echo "client_id=docker" >> ../local.properties && \
    echo "auth_uri=https://accounts.google.com/o/oauth2/auth" >> ../local.properties && \
    echo "token_uri=https://oauth2.googleapis.com/token" >> ../local.properties && \
    echo "auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs" >> ../local.properties && \
    echo "client_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs" >> ../local.properties && \
    echo "universe_domain=googleapis.com" >> ../local.properties

# Fix line endings and run optimized build process
RUN echo "=== Fixing Line Endings ===" && \
    sed -i 's/\r$//' ../gradlew && \
    chmod +x ../gradlew && \
    echo "=== Environment Check ===" && \
    kobweb --version && \
    java -version && \
    echo "=== Gradle Clean ===" && \
    ../gradlew clean --no-daemon && \
    echo "=== Kobweb Export (includes build automatically) ===" && \
    kobweb export --notty && \
    echo "=== Export Complete ===" && \
    ls -la .kobweb/ && \
    # Aggressive cleanup to minimize image size (preserve all functionality from original)
    rm -rf ~/.gradle/caches ~/.gradle/daemon build/js/node_modules build/tmp build/kotlin .gradle && \
    # Clean npm cache like original Dockerfile
    npx npm@10.8.2 cache clean --force

#-----------------------------------------------------------------------------
# Stage 2: Minimal Runtime
#-----------------------------------------------------------------------------
FROM eclipse-temurin:21-jre AS runtime

ARG KOBWEB_APP_ROOT

# Copy only the exported site
COPY --from=export /project/${KOBWEB_APP_ROOT}/.kobweb .kobweb

# Create non-root user and validate (preserve all original functionality)
RUN groupadd -r kobweb && useradd -r -g kobweb kobweb && \
    # Verify essential files exist
    test -f .kobweb/server/start.sh || (echo "ERROR: start.sh not found - export may have failed" && exit 1) && \
    # Set proper permissions
    chown -R kobweb:kobweb .kobweb && \
    chmod +x .kobweb/server/start.sh && \
    # Create required directories if missing (like original)
    mkdir -p /tmp && chown kobweb:kobweb /tmp

USER kobweb
EXPOSE 8080

# Start the Kobweb server
ENTRYPOINT ["./.kobweb/server/start.sh"]