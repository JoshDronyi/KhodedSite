# Minimal Dockerfile - Build Java application without Kobweb export
# This bypasses the complex Kobweb static site generation for now

FROM eclipse-temurin:21-jdk AS build

# Copy project files
COPY . /project
WORKDIR /project

# Fix Windows line endings
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew

# Configure Gradle with minimal settings
RUN mkdir -p ~/.gradle && echo "\
org.gradle.jvmargs=-Xmx1g -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError\n\
org.gradle.daemon=false\n\
org.gradle.parallel=false\n\
org.gradle.console=plain" > ~/.gradle/gradle.properties

# Create minimal local.properties to prevent build errors
RUN echo "# Minimal Docker build properties" > local.properties && \
    echo "type=service_account" >> local.properties && \
    echo "project_id=docker-build" >> local.properties && \
    echo "private_key_id=docker-key" >> local.properties && \
    echo "private_key=-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC\n-----END PRIVATE KEY-----" >> local.properties && \
    echo "client_email=docker@build.com" >> local.properties && \
    echo "client_id=123456789" >> local.properties && \
    echo "auth_uri=https://accounts.google.com/o/oauth2/auth" >> local.properties && \
    echo "token_uri=https://oauth2.googleapis.com/token" >> local.properties

# Build only the JVM application (skip JS compilation that's failing)
RUN ./gradlew :site:compileKotlinJvm :site:jvmJar --no-daemon --stacktrace

# Runtime stage
FROM eclipse-temurin:21-jre AS runtime

# Create app directory
WORKDIR /app

# Copy the built JAR
COPY --from=build /project/site/build/libs/*.jar /app/app.jar

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8080

# Environment variables for runtime
ENV JAVA_OPTS="-Xmx512m -XX:+UseG1GC"
ENV DATABASE_URL=jdbc:h2:mem:testdb
ENV ADMIN_EMAIL=hello@khoded.com

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]