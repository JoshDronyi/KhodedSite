# Khoded Production Environment Configuration Template
# Copy this file to .env.production and fill in your actual values

# Application Environment
APP_ENVIRONMENT=production
PRIMARY_DOMAIN=your-app.onrender.com
SERVER_PORT=8080

# Database Configuration
# Get these values from your Render PostgreSQL addon
DATABASE_PROD_URI=postgresql://username:password@host:port/database
DATABASE_PROD_USERNAME=your_db_username
DATABASE_PROD_PASSWORD=your_db_password

# Gmail API Configuration
# Get these from your Google Cloud Console service account
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_CERT_URL=your_client_cert_url
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

# Security Settings
SSL_ENABLED=true
CORS_ALLOWED_ORIGINS=https://your-app.onrender.com,https://www.your-app.onrender.com

# Feature Flags
ENABLE_METRICS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_SECURITY_HEADERS=true
ENABLE_COMPRESSION=true

# Logging
LOG_LEVEL=INFO

# Health Check
HEALTH_CHECK_ENDPOINT=/health-api

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15

# Performance
CACHE_ENABLED=true
CDN_ENABLED=true