# Khoded Staging Environment Configuration
# Copy this file to the project root as .env.staging

# Application Environment
APP_ENVIRONMENT=staging
PRIMARY_DOMAIN=khoded-staging.onrender.com
SERVER_PORT=8080

# Database Configuration (Override with DATABASE_URL in staging)
DATABASE_DEV_URI=jdbc:postgresql://database:5432/khoded_staging
DATABASE_DEV_USERNAME=khoded_staging_user
DATABASE_DEV_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
DATABASE_PROD_URI=jdbc:postgresql://database:5432/khoded_staging
DATABASE_PROD_USERNAME=khoded_staging_user
DATABASE_PROD_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD

# Flyway Configuration
FLYWAY_URL=jdbc:postgresql://database:5432/khoded_staging
FLYWAY_USER=khoded_staging_user
FLYWAY_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD

# Gmail API Configuration - Khoded-staging Project
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=Khoded-staging
GOOGLE_PRIVATE_KEY_ID=REPLACE_WITH_STAGING_PRIVATE_KEY_ID
GOOGLE_PRIVATE_KEY=REPLACE_WITH_STAGING_PRIVATE_KEY
GOOGLE_CLIENT_EMAIL=khoded-staging-service@khoded-staging.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_CLIENT_ID
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/khoded-staging-service%40khoded-staging.iam.gserviceaccount.com
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

# Security Settings
SSL_ENABLED=true
CORS_ALLOWED_ORIGINS=https://khoded-staging.onrender.com

# Feature Flags
ENABLE_METRICS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_SECURITY_HEADERS=true
ENABLE_COMPRESSION=true

# Logging
LOG_LEVEL=INFO

# Health Check
HEALTH_CHECK_ENDPOINT=/health

# Staging Features
DEBUG_MODE=false
HOT_RELOAD=false
MOCK_EMAIL_SERVICE=false

# Backup Configuration
ENABLE_BACKUPS=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
LOKI_ENABLED=true