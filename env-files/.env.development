# Khoded Development Environment Configuration
# Copy this file to the project root as .env.development

# Application Environment
APP_ENVIRONMENT=development
PRIMARY_DOMAIN=localhost:8080
SERVER_PORT=8080

# Database Configuration
DATABASE_DEV_URI=jdbc:postgresql://localhost:5432/khodedBackendData
DATABASE_DEV_USERNAME=admin
DATABASE_DEV_PASSWORD=khodedData
DATABASE_PROD_URI=jdbc:postgresql://localhost:5432/khodedBackendData
DATABASE_PROD_USERNAME=admin  
DATABASE_PROD_PASSWORD=khodedData

# Flyway Configuration
FLYWAY_URL=jdbc:postgresql://localhost:5432/khodedBackendData
FLYWAY_USER=admin
FLYWAY_PASSWORD=khodedData

# Gmail API Configuration - Development (No real sending)
# You can leave these empty for development or use test values
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=khoded-dev-test
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_CERT_URL=
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

# Security Settings
SSL_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Feature Flags
ENABLE_METRICS=true
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_SECURITY_HEADERS=false
ENABLE_COMPRESSION=false

# Logging
LOG_LEVEL=DEBUG

# Health Check
HEALTH_CHECK_ENDPOINT=/health

# Development Features
DEBUG_MODE=true
HOT_RELOAD=true
MOCK_EMAIL_SERVICE=true