# Environment Variables Template for Khoded Website
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# =============================================================================
# GOOGLE SERVICE ACCOUNT CONFIGURATION
# =============================================================================
# IMPORTANT: Use JSON format for service account credentials
# Copy the entire content of your service account JSON file
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"your-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYour-Private-Key\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","universe_domain":"googleapis.com"}

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Development Database
DATABASE_DEV_URI=jdbc:postgresql://localhost:5432/khodedBackendData
DATABASE_DEV_USERNAME=khodedAdmin
DATABASE_DEV_PASSWORD=your-secure-dev-password

# Production Database
DATABASE_PROD_URI=jdbc:postgresql://your-prod-host:5432/khodedBackendData
DATABASE_PROD_USERNAME=khodedAdmin
DATABASE_PROD_PASSWORD=your-secure-prod-password

# Test Database
DATABASE_TEST_USERNAME=test_user
DATABASE_TEST_PASSWORD=test_password

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
APP_ENVIRONMENT=development

# Server configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SIZE_MINUTES=1

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://your-domain.com

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Google Analytics (optional)
GA_TRACKING_ID=GA-XXXXXXXXX-X

# Error reporting endpoint (optional)
ERROR_REPORTING_URL=https://your-error-service.com/api/errors

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email settings
ADMIN_EMAIL=admin@khoded.com
FROM_EMAIL=noreply@khoded.com

# =============================================================================
# DOCKER CONFIGURATION (for docker-compose)
# =============================================================================

# Database container settings
POSTGRES_DB=khodedBackendData
POSTGRES_USER=khodedAdmin
POSTGRES_PASSWORD=khodedAdmin

# Application container settings
JAVA_OPTS=-Xmx1g -XX:+UseG1GC