# Khoded Environment Configuration Template
# Copy this file and fill in your actual values
# NEVER commit the actual .env files to git!

# Application Environment
APP_ENVIRONMENT=development
PRIMARY_DOMAIN=localhost:8080
SERVER_PORT=8080

# Database Configuration (will be overridden by DATABASE_URL in production)
DATABASE_DEV_URI=jdbc:postgresql://localhost:5432/khoded_dev
DATABASE_DEV_USERNAME=khoded_dev_user
DATABASE_DEV_PASSWORD=

DATABASE_PROD_URI=
DATABASE_PROD_USERNAME=
DATABASE_PROD_PASSWORD=

# Gmail API Configuration (set these in GitHub secrets)
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_CERT_URL=
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

# Security Settings
SSL_ENABLED=false
CORS_ALLOWED_ORIGINS=*

# Feature Flags
ENABLE_METRICS=true
ENABLE_PERFORMANCE_MONITORING=false
ENABLE_SECURITY_HEADERS=true
ENABLE_COMPRESSION=true

# Logging
LOG_LEVEL=INFO

# Health Check
HEALTH_CHECK_ENDPOINT=/health