package com.probro.khoded.pages.homeSections

import androidx.compose.runtime.*
import com.probro.khoded.components.OptimizedImage
import com.probro.khoded.utils.Pages
import com.varabyte.kobweb.compose.css.ContainIntrinsicBlockSize.Companion.Auto
import com.varabyte.kobweb.compose.foundation.layout.Arrangement
import com.varabyte.kobweb.compose.foundation.layout.Column
import com.varabyte.kobweb.compose.foundation.layout.Row
import com.varabyte.kobweb.compose.ui.Alignment
import com.varabyte.kobweb.compose.ui.Modifier
import com.varabyte.kobweb.compose.ui.modifiers.*
import com.varabyte.kobweb.compose.ui.styleModifier
import com.varabyte.kobweb.compose.ui.toAttrs
import org.jetbrains.compose.web.css.*
import org.jetbrains.compose.web.css.keywords.auto
import org.jetbrains.compose.web.dom.*

@Composable
fun ServicesSectionDisplay(data: Pages.Home_Section.Services) = with(data) {
    Section(
        attrs = Modifier
            .fillMaxWidth()
            .backgroundColor(Color.white)
            .padding(topBottom = 60.px)
            .styleModifier {
                property("@media (min-width: 768px)", "{ padding-top: 100px; padding-bottom: 100px; }")
            }
            .toAttrs()
    ) {
        Div(
            attrs = Modifier
                .fillMaxWidth()
                .maxWidth(1200.px)
                .padding(leftRight = 20.px)
                .styleModifier {
                    property("margin", "0 auto")
                    property("display", "grid")
                    property("grid-template-columns", "1fr")
                    property("gap", "40px")
                    property("align-items", "center")
                    property("@media (min-width: 768px)", "{ grid-template-columns: 1fr 1fr; gap: 80px; padding-left: 24px; padding-right: 24px; }")
                }
                .toAttrs()
        ) {
            // Left side - Character illustration
            Div(
                attrs = Modifier
                    .styleModifier {
                        property("display", "flex")
                        property("justify-content", "center")
                        property("align-items", "center")
                        property("order", "1")
                        property("@media (min-width: 768px)", "{ order: 1; }")
                    }
                    .toAttrs()
            ) {
                OptimizedImage(
                    src = data.mainImage,
                    description = "Person working on laptop with charts",
                    modifier = Modifier
                        .fillMaxWidth()
                        .maxWidth(300.px)
                        .height(250.px)
                        .styleModifier {
                            property("object-fit", "contain")
                            property("@media (min-width: 768px)", "{ max-width: 500px; height: 400px; }")
                        }
                )
            }

            // Right side - Services content
            Column(
                verticalArrangement = Arrangement.spacedBy(32.px),
                horizontalAlignment = Alignment.CenterHorizontally,
                modifier = Modifier
                    .styleModifier {
                        property("order", "2")
                        property("text-align", "center")
                        property("@media (min-width: 768px)", "{ order: 2; text-align: left; }")
                    }
            ) {
                // Title with underline
                Column(
                    verticalArrangement = Arrangement.spacedBy(16.px)
                ) {
                    H2(
                        attrs = Modifier
                            .fontSize(32.px)
                            .fontWeight(700)
                            .color(rgb(51, 51, 51))
                            .margin(0.px)
                            .lineHeight(1.2)
                            .styleModifier {
                                property("@media (min-width: 768px)", "{ font-size: 48px; }")
                            }
                            .toAttrs()
                    ) {
                        Text("OUR SERVICES")
                    }

                    // Pink underline decoration
                    Div(
                        attrs = Modifier
                            .width(200.px)
                            .height(4.px)
                            .backgroundColor(rgb(236, 72, 153)) // Pink color
                            .borderRadius(2.px)
                            .toAttrs()
                    )
                }

                // Services list
                Column(
                    verticalArrangement = Arrangement.spacedBy(32.px)
                ) {
                    ServiceItem(
                        title = "TAILORED WEB WIZARDRY",
                        description = "Custom websites built from scratch with modern technologies"
                    )

                    ServiceItem(
                        title = "TURBO-SECURE HOSTING",
                        description = "Fast, reliable, and secure hosting solutions"
                    )

                    ServiceItem(
                        title = "ULTIMATE BRAND PLAYBOOK",
                        description = "Complete branding solutions for your business"
                    )
                }
            }
        }
    }
}

@Composable
private fun ServiceItem(
    title: String,
    description: String
) {
    Row(
        verticalAlignment = Alignment.Top,
        horizontalArrangement = Arrangement.spacedBy(16.px)
    ) {
        // Plus icon
        Div(
            attrs = Modifier
                .size(24.px)
                .backgroundColor(rgb(51, 51, 51))
                .borderRadius(2.px)
                .styleModifier {
                    property("display", "flex")
                    property("align-items", "center")
                    property("justify-content", "center")
                    property("color", "white")
                    property("font-size", "16px")
                    property("font-weight", "700")
                    property("flex-shrink", "0")
                    property("margin-top", "4px")
                }
                .toAttrs()
        ) {
            Text("+")
        }

        Column(
            verticalArrangement = Arrangement.spacedBy(8.px)
        ) {
            // Service title
            H3(
                attrs = Modifier
                    .fontSize(20.px)
                    .fontWeight(700)
                    .color(rgb(51, 51, 51))
                    .margin(0.px)
                    .letterSpacing(0.5.px)
                    .toAttrs()
            ) {
                Text(title)
            }

            // Pink underline for each service
            Div(
                attrs = Modifier
                    .width(100.px)
                    .height(2.px)
                    .backgroundColor(rgb(236, 72, 153)) // Pink color
                    .borderRadius(1.px)
                    .toAttrs()
            )

            // Service description (optional - not shown in target but could be added)
            if (description.isNotEmpty()) {
                P(
                    attrs = Modifier
                        .fontSize(14.px)
                        .lineHeight(1.6)
                        .color(rgb(107, 114, 128))
                        .margin(0.px)
                        .toAttrs()
                ) {
                    Text(description)
                }
            }
        }
    }
}